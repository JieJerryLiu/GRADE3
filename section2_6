<script>
let questions = [
{ nums: [8, 9, 6], type: '+', answer: '23' },
{ nums: [23, 42, 97], type: '+', answer: '162' },
{ nums: [21, 58, 47], type: '+', answer: '126' },
{ nums: [13, 7, 19], type: '+', answer: '39' },
{ nums: [22, 16, 24], type: '+', answer: '62' },

{ nums: [180, 360, 190], type: '+', answer: '730' },
{ nums: [423, 747, 521], type: '+', answer: '1691' },
{ nums: [123, 423, 415], type: '+', answer: '961' },
{ nums: [180, 360, 190], type: '+', answer: '730' },
{ nums: [5023, 1764], type: '+', answer: '6787' },

{ nums: [2201, 970], type: '+', answer: '3171' },
{ nums: [4321, 2841], type: '+', answer: '7162' },
{ nums: [1436, 5120], type: '+', answer: '6556' },
{ nums: [1960, 420], type: '-', answer: '1540' },
{ nums: [1340, 380], type: '-', answer: '960' },

{ nums: [4120, 3290], type: '-', answer: '830' },
{ nums: [720, 340], type: '-', answer: '380' },
{ nums: [5947, 4272], type: '-', answer: '1675' },
{ nums: [312, 20], type: '-', answer: '292' },
{ nums: [1501, 1200], type: '-', answer: '301' },

{ nums: [5803, 1992], type: '-', answer: '3811' },
{ nums: [1906, 1173], type: '-', answer: '733' },
{ nums: [5120, 1780], type: '-', answer: '3340' },
{ nums: [4500, 720], type: '-', answer: '3780' },
{ nums: [9645, 6823], type: '-', answer: '2822' },

{ roundNum: 534, place: 'tens', type: 'round', answer: '530' },
{ roundNum: 969, place: 'hundreds', type: 'round', answer: '1000' },
{ roundNum: 831, place: 'hundreds', type: 'round', answer: '800' },
{ roundNum: 419, place: 'tens', type: 'round', answer: '420' }
];

let current = 0;
let userAnswers = new Array(questions.length).fill("");
let studentName = "";
let sectionName = "Chapter 3 Pretest";
let submitted = false;

const sheetURL = "https://script.google.com/macros/s/AKfycbwHkMC01_kIZ3S5Hp1fkTLVzsrwq3EZQeCbfnXNE7sTJZHdtbqj6oW8jF1Kf0Q-fUo6bw/exec";

function startQuiz(){
    studentName = document.getElementById('studentName').value.trim();
    if(!studentName){
        alert("Please enter your name.");
        return;
    }
    document.getElementById('startPage').style.display = 'none';
    document.getElementById('quizPage').style.display = 'block';
    loadQuestion();
}

function answerInputs(){
    return `
        <div></div>
        <div class="inputs"><input id="d0" maxlength="1"></div>
        <div class="inputs"><input id="d1" maxlength="1"></div>
        <div class="inputs"><input id="d2" maxlength="1"></div>
        <div class="inputs"><input id="d3" maxlength="1"></div>
    `;
}

function loadQuestion(){
    let q = questions[current];
    let gridHtml = "";

    if(q.type === "round"){
        gridHtml += `<div style="grid-column: span 5; font-size:22px;">Round ${q.roundNum} to the ${q.place}</div>`;
        gridHtml += `<div class="line"></div>`;
        gridHtml += answerInputs();
    } else {
        q.nums.forEach((num, index) => {
            let padded = num.toString().padStart(4, ' ');
            let digits = padded.split('');
            let symbol = index === q.nums.length - 1 ? q.type : "";

            gridHtml += `<div>${symbol}</div>`;
            gridHtml += `<div>${digits[0] === ' ' ? '' : digits[0]}</div>`;
            gridHtml += `<div>${digits[1] === ' ' ? '' : digits[1]}</div>`;
            gridHtml += `<div>${digits[2] === ' ' ? '' : digits[2]}</div>`;
            gridHtml += `<div>${digits[3] === ' ' ? '' : digits[3]}</div>`;
        });

        gridHtml += `<div class="line"></div>`;
        gridHtml += answerInputs();
    }

    document.getElementById("grid").innerHTML = gridHtml;

    let saved = userAnswers[current];
    if(saved){
        let digits = saved.toString().padStart(4, ' ').split('');
        document.getElementById('d0').value = digits[0].trim();
        document.getElementById('d1').value = digits[1].trim();
        document.getElementById('d2').value = digits[2].trim();
        document.getElementById('d3').value = digits[3].trim();
    }

    document.getElementById("questionNum").innerText = `Question ${current+1} / ${questions.length}`;
    document.getElementById('d3').focus();

    submitted = false;
    document.getElementById('resultImg').style.display = 'none';
    document.getElementById('resultImg').src = "";
    document.getElementById('prevBtn').style.display = 'none';
    document.getElementById('nextBtn').innerText = 'Submit';
}

function saveAnswer(){
    let combined = ['d0','d1','d2','d3'].map(id => document.getElementById(id).value || '').join('').trim();
    userAnswers[current] = combined === "" ? "" : parseInt(combined, 10).toString();
}

function submitOrNext(){
    if(!submitted){
        saveAnswer();
        let user = userAnswers[current] || "";
        let isCorrect = user === questions[current].answer;

        let img = document.getElementById('resultImg');
        img.src = isCorrect ? "correct.png" : "wrong.png";
        img.style.display = "block";

        submitted = true;
        document.getElementById('prevBtn').style.display = 'block';
        document.getElementById('prevBtn').disabled = current === 0;
        document.getElementById('nextBtn').innerText = current === questions.length - 1 ? "Finish" : "Next";
    } else {
        nextQuestion();
    }
}

function nextQuestion(){
    saveAnswer();
    if(current === questions.length - 1){
        finishQuiz();
    } else {
        current++;
        loadQuestion();
    }
}

function prevQuestion(){
    saveAnswer();
    if(current > 0){
        current--;
        loadQuestion();
    }
}

function finishQuiz(){
    saveAnswer();
    let score = 0;
    let details = [];

    questions.forEach((q, i) => {
        let user = userAnswers[i] || "";
        let isCorrect = user === q.answer;
        if(isCorrect) score++;
        else details.push(`Q${i+1}: User=${user||"blank"}, Correct=${q.answer}`);
    });

    let resultHtml = `
        <div style="text-align:center;">
            <h1>Quiz Finished!</h1>
            <h2>Score: ${score} / ${questions.length}</h2>
            <div style="text-align:left; display:inline-block; margin-bottom:20px;">
    `;

    questions.forEach((q, i) => {
        let isCorrect = userAnswers[i] === q.answer;
        resultHtml += `<p>${isCorrect ? "✅" : "❌"} Question ${i+1} ${!isCorrect ? "(Correct: "+q.answer+")" : ""}</p>`;
    });

    resultHtml += `
            </div>
            <br>
            <button onclick="location.reload()" style="background:#2196F3; width:200px;">Restart Quiz</button>
        </div>
    `;

    document.getElementById('container').innerHTML = resultHtml;

    fetch(sheetURL, {
        method: 'POST',
        mode: 'no-cors',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
            Name: studentName,
            Section: sectionName,
            Score: `${score} / ${questions.length}`,
            Details: details.join("; "),
            Time: new Date().toLocaleString()
        })
    }).catch(err => console.error("Save Error:", err));
}
</script>
